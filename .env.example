# Kopiér til .env.local og udfyld. Se SANITY.md for hvor værdierne kommer fra.
# .env* er git-ignoreret — den her fil er den eneste, der må committes.

# --- Sanity -----------------------------------------------------------------
# Uden projekt-id'et henter sitet cases fra src/content/cases.ts og virker
# som før. Det er en rampe, ikke en reserve — se SANITY.md trin 6.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Deles med webhooken i sanity.io/manage. Kun i Vercel, ikke i browseren.
SANITY_WEBHOOK_SECRET=

# Kun til den ENGANGS-import, der flytter cases ind. Ikke i Vercel.
SANITY_WRITE_TOKEN=

# --- Kontaktformularen ------------------------------------------------------
# Uden nøglen siger formularen ærligt, at beskeden ikke kunne sendes, og
# henviser til mail og telefon. Ingen henvendelser går tabt i stilhed.
RESEND_API_KEY=

# Afsenderadressen. Domænet skal være verificeret i Resend.
KONTAKT_FRA="MNmedia <kontakt@mnmedia.dk>"
